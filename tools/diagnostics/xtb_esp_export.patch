+! Shared primitive product preparation, without file or COMMON state.
+      subroutine propa_data(a,b,alpha,beta,la,lb,
+     &                      nnn,efact,gama,e,dd)
+      use xtb_intpack
+      implicit none
+      integer la,lb,nnn
+      real*8 a(3),b(3),alpha,beta,efact,gama,e(3),dd(35)
+      real*8 aa(20),bb(20),product(84),cij,ckl
+      aa=0
+      bb=0
+      aa(la)=1
+      bb(lb)=1
+      cij=0
+      ckl=0
+      call divpt(a,alpha,b,beta,cij,ckl,e,gama,efact)
+      call rhftce(aa,a,e,la)
+      call rhftce(bb,b,e,lb)
+      call prod(aa,bb,product,la,lb)
+      dd=product(1:35)
+      call lprimprod(la,lb,nnn)
+      end
 
+! In-memory counterpart of espplot; identical CLI screening constants.
+! Input coordinates in Bohr, output potential in atomic units (Eh/e).
+      subroutine esp_points(n,nmo,nbf,xyz,z,occ,C,basis,
+     &                      np,points,values)
+      use xtb_type_basisset
+      use xtb_intpack, only: opaa0
+      implicit none
+      type(TBasisset), intent(in) :: basis
+      integer n,nmo,nbf,np
+      real*8 xyz(3,n),z(n),occ(nmo),C(nbf,nmo)
+      real*8 points(3,np),values(np)
+      real*8 p,cc,est,gama,efact,e(3),dd(35),a(3),b(3)
+      real*8 rab,r,weight,v
+      integer i,j,k,m,ii,jj,ip,jp,iii,jjj,nnn
+      values=0
+      do k=1,np
+         do i=1,n
+            r=sqrt(sum((xyz(:,i)-points(:,k))**2))
+            values(k)=values(k)+z(i)/(1.d-14+r)
+         enddo
+      enddo
+      ip=0
+      do i=1,nbf
+         a=xyz(:,basis%aoat(i))
+         jp=0
+         do j=1,i
+            p=0
+            do m=1,nmo
+               if(occ(m).gt.1.d-6) p=p+occ(m)*C(i,m)*C(j,m)
+            enddo
+            if(i.ne.j) p=2*p
+            if(abs(p).ge.1.d-4) then
+               b=xyz(:,basis%aoat(j))
+               rab=sum((a-b)**2)
+               do ii=1,basis%nprim(i)
+                  iii=ip+ii
+                  do jj=1,basis%nprim(j)
+                     jjj=jp+jj
+                     gama=1/(basis%alp(iii)+basis%alp(jjj))
+                     est=rab*basis%alp(iii)*basis%alp(jjj)*gama
+                     cc=basis%cont(iii)*basis%cont(jjj)
+                     if(est.lt.10.and.abs(cc*p).gt.1.d-5) then
+                        call propa_data(a,b,basis%alp(iii),
+     &                     basis%alp(jjj),basis%lao(i),basis%lao(j),
+     &                     nnn,efact,gama,e,dd)
+                        weight=cc*efact*p
+                        if(abs(weight).gt.5.d-7) then
+                           do k=1,np
+                              call propa1(opaa0,points(:,k),nnn,
+     &                                    gama,e,dd,v)
+                              values(k)=values(k)-v*weight
+                           enddo
+                        endif
+                     endif
+                  enddo
+               enddo
+            endif
+            jp=jp+basis%nprim(j)
+         enddo
+         ip=ip+basis%nprim(i)
+      enddo
       end
 
