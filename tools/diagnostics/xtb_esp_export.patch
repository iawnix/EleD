+! ESP snapshots own geometry, basis, occupations and Cartesian coefficients.
+function rdkit_esp_version() result(version) bind(C, name="xtb_rdkit_getESPAPIVersion")
+   integer(c_int) :: version
+   version = 1
+end function
+
+subroutine rdkit_keep_esp(venv, vres, keep) bind(C, name="xtb_rdkit_setKeepESP")
+   type(c_ptr), value :: venv, vres
+   logical(c_bool), value :: keep
+   type(VEnvironment), pointer :: env
+   type(VResults), pointer :: res
+   if (.not.c_associated(venv)) return
+   call c_f_pointer(venv, env)
+   call checkGlobalEnv
+   if (.not.c_associated(vres)) then
+      call env%ptr%error("Results object is not allocated", "rdkit_esp")
+      return
+   end if
+   call c_f_pointer(vres, res)
+   if (allocated(res%esp)) deallocate(res%esp)
+   res%rdkit_keep_esp = keep
+end subroutine
+
+! Return 1 on success, 0 on error; output remains untouched on error.
+function rdkit_get_esp(venv, vres, count, points_ptr, capacity, output_ptr) result(ok) &
+      & bind(C, name="xtb_rdkit_getESP")
+   type(c_ptr), value :: venv, vres, points_ptr, output_ptr
+   integer(c_int), value :: count, capacity
+   integer(c_int) :: ok
+   type(VEnvironment), pointer :: env
+   type(VResults), pointer :: res
+   real(c_double), pointer :: points(:, :), output(:)
+   real(wp), allocatable :: values(:)
+   integer :: i, j
+   ok = 0
+   if (.not.c_associated(venv)) return
+   call c_f_pointer(venv, env)
+   call checkGlobalEnv
+   if (.not.c_associated(vres)) then
+      call env%ptr%error("Results object is not allocated", "rdkit_esp")
+      return
+   end if
+   call c_f_pointer(vres, res)
+   if (.not.allocated(res%esp)) then
+      call env%ptr%error("ESP snapshot unavailable; enable retention before singlepoint", "rdkit_esp")
+      return
+   end if
+   if (count <= 0 .or. capacity /= count .or. .not.c_associated(points_ptr) .or. &
+       & .not.c_associated(output_ptr)) then
+      call env%ptr%error("ESP point count/buffer size/null mismatch", "rdkit_esp")
+      return
+   end if
+   call c_f_pointer(points_ptr, points, [3, count])
+   call c_f_pointer(output_ptr, output, [count])
+   if (.not.all(ieee_is_finite(points))) then
+      call env%ptr%error("ESP points must be finite", "rdkit_esp")
+      return
+   end if
+   do i = 1, count
+      do j = 1, size(res%esp%z)
+         if (norm2(points(:, i)-res%esp%xyz(:, j)) < 1.0e-10_wp) then
+            call env%ptr%error("ESP is singular at a nuclear position", "rdkit_esp")
+            return
+         end if
+      end do
+   end do
+   allocate(values(count))
+   associate(s => res%esp)
+      call esp_points(size(s%z), s%basis%nao, s%basis%nbf, s%xyz, s%z, &
+         & s%occ, s%coefficients, s%basis, count, points, values)
+   end associate
+   if (.not.all(ieee_is_finite(values))) then
+      call env%ptr%error("ESP evaluation produced nonfinite values", "rdkit_esp")
+      return
+   end if
+   output = values
+   ok = 1
+end function
+
 end module xtb_api_results
