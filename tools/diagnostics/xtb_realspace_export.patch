diff --git a/include/xtb.h b/include/xtb.h
--- a/include/xtb.h
+++ b/include/xtb.h
@@ -400,6 +400,23 @@
 extern XTB_API_ENTRY int XTB_API_CALL xtb_rdkit_getNuclearESP(
     xtb_TEnvironment, xtb_TResults, int natoms, double* output);
 
+/* EleD real-space wavefunction ABI v1; upstream API version remains unchanged.
+ * Evaluates exact Cartesian GTO valence electron density rho(r) (e/Bohr^3),
+ * Average Local Ionization Energy ALIE(r) (eV), virtual density (1/Bohr^3),
+ * and Local Electron Affinity LEA(r) (eV) at arbitrary 3D points (Bohr) from
+ * an existing nonperiodic GFN0/1/2 singlepoint snapshot without new SCF calls.
+ * points: contiguous [npoints][3] in Bohr. Outputs: [npoints] doubles each.
+ * occ_threshold >= 0 separates occupied (f > thr) and virtual (f <= thr) MOs.
+ * lea_window_ev == 0 includes all valence virtual MOs; > 0 restricts virtual
+ * MOs to [LUMO, LUMO + lea_window_ev]. Returns 1 on success, 0 on error
+ * (environment diagnostic set, output buffers untouched).
+ */
+extern XTB_API_ENTRY int XTB_API_CALL xtb_rdkit_getRealSpaceAPIVersion(void);
+extern XTB_API_ENTRY int XTB_API_CALL xtb_rdkit_evalRealSpace(
+    xtb_TEnvironment, xtb_TResults, int npoints, const double* points,
+    double occ_threshold, double lea_window_ev,
+    double* density, double* alie_ev, double* vir_density, double* lea_ev);
+
 #ifdef __cplusplus
 }
 #endif
