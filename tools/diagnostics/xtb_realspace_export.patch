+ * at arbitrary 3D points (Bohr) from an existing nonperiodic GFN0/1/2
+ * singlepoint snapshot without new SCF calls.
+ * v2 (xtb_rdkit_evalRealSpaceDerivatives): analytical GTO first/second
+ * derivatives yielding density (e/Bohr^3), grad_rho [npoints][3] (e/Bohr^4),
+ * symmetric hess_rho [npoints][6] packed (xx,xy,yy,xz,yz,zz) (e/Bohr^5),
+ * laplacian (e/Bohr^5), kinetic energy density tau (Hartree/Bohr^3), Becke-
+ * Edgecombe ELF, Schmider-Becke LOL, reduced density gradient RDG, and
+ * sign(lambda2)*rho (e/Bohr^3).
+ * Returns 1 on success, 0 on error (diagnostic set, output buffers untouched).
+ */
+extern XTB_API_ENTRY int XTB_API_CALL xtb_rdkit_getRealSpaceAPIVersion(void);
+extern XTB_API_ENTRY int XTB_API_CALL xtb_rdkit_evalRealSpace(
+    xtb_TEnvironment, xtb_TResults, int npoints, const double* points,
+    double occ_threshold, double lea_window_ev,
+    double* density, double* alie_ev, double* vir_density, double* lea_ev);
