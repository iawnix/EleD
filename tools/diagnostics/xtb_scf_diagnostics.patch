+! Diagnostics ABI v1: successful GFN1/2 SCC only. Values are final absolute
+! energy change (Hartree), mixed-variable RMS, and their engine thresholds.
+! GFN2 RMS includes multipoles; it must not be labeled an atomic-charge RMS.
+function rdkit_scf_version() result(version) bind(C, name="xtb_rdkit_getSCFAPIVersion")
+   integer(c_int) :: version
+   version = 1
+end function
+
+function rdkit_scf_diagnostics(venv, vres, iterations, values) result(available) &
+      & bind(C, name="xtb_rdkit_getSCFDiagnostics")
+   type(c_ptr), value :: venv, vres, iterations, values
+   integer(c_int) :: available
+   type(VResults), pointer :: res
+   integer(c_int), pointer :: n
+   real(c_double), pointer :: data(:)
+   available = 0
+   if (.not.c_associated(venv) .or. .not.c_associated(vres)) return
+   if (.not.c_associated(iterations) .or. .not.c_associated(values)) return
+   call c_f_pointer(vres, res)
+   if (res%rdkit_scf_iterations < 0) return
+   call c_f_pointer(iterations, n)
+   call c_f_pointer(values, data, [4])
+   n = res%rdkit_scf_iterations
+   data = res%rdkit_scf_values
+   available = 1
+end function
+
 end module xtb_api_results
