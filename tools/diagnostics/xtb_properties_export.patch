+! Extended properties ABI v1.
+function rdkit_properties_version() result(version) bind(C, name="xtb_rdkit_getPropertiesAPIVersion")
+   integer(c_int) :: version
+   version = 1
+end function
+
+function rdkit_get_energy_decomposition(venv, vres, flags_ptr, capacity, values_ptr) result(ok) &
+      & bind(C, name="xtb_rdkit_getEnergyDecomposition")
+   type(c_ptr), value :: venv, vres, flags_ptr, values_ptr
+   integer(c_int), value :: capacity
+   integer(c_int) :: ok
+   type(VResults), pointer :: res
+   integer(c_int), pointer :: flags_out
+   real(c_double), pointer :: values_out(:)
+   ok = 0
+   if (.not.c_associated(venv) .or. .not.c_associated(vres)) return
+   if (capacity /= 15 .or. .not.c_associated(flags_ptr) .or. .not.c_associated(values_ptr)) return
+   call c_f_pointer(vres, res)
+   if (.not.allocated(res%props)) return
+   if (.not.all(ieee_is_finite(res%props%energies))) return
+   call c_f_pointer(flags_ptr, flags_out)
+   call c_f_pointer(values_ptr, values_out, [15])
+   flags_out = res%props%energy_flags
+   values_out = res%props%energies
+   ok = 1
+end function
+
+function rdkit_get_polarizability(venv, vres, natoms, mol_ptr, alpha_ptr, c6_ptr) result(ok) &
+      & bind(C, name="xtb_rdkit_getPolarizability")
+   type(c_ptr), value :: venv, vres, mol_ptr, alpha_ptr, c6_ptr
+   integer(c_int), value :: natoms
+   integer(c_int) :: ok
+   type(VResults), pointer :: res
+   real(c_double), pointer :: mol_out(:), alpha_out(:), c6_out(:)
+   ok = 0
+   if (.not.c_associated(venv) .or. .not.c_associated(vres)) return
+   if (natoms <= 0 .or. .not.c_associated(mol_ptr) .or. .not.c_associated(alpha_ptr) .or. &
+       & .not.c_associated(c6_ptr)) return
+   call c_f_pointer(vres, res)
+   if (.not.allocated(res%props)) return
+   if (.not.res%props%has_polarizability .or. res%props%natoms /= natoms) return
+   if (.not.allocated(res%props%atomic_alpha) .or. .not.allocated(res%props%atomic_c6)) return
+   if (.not.all(ieee_is_finite(res%props%mol_pol)) .or. &
+       & .not.all(ieee_is_finite(res%props%atomic_alpha)) .or. &
+       & .not.all(ieee_is_finite(res%props%atomic_c6))) return
+   call c_f_pointer(mol_ptr, mol_out, [3])
+   call c_f_pointer(alpha_ptr, alpha_out, [natoms])
+   call c_f_pointer(c6_ptr, c6_out, [natoms])
+   mol_out = res%props%mol_pol
+   alpha_out = res%props%atomic_alpha
+   c6_out = res%props%atomic_c6
+   ok = 1
+end function
+
+function rdkit_get_multipoles(venv, vres, natoms, dip_ptr, quad_ptr, mol_quad_ptr) result(ok) &
+      & bind(C, name="xtb_rdkit_getMultipoles")
+   type(c_ptr), value :: venv, vres, dip_ptr, quad_ptr, mol_quad_ptr
+   integer(c_int), value :: natoms
+   integer(c_int) :: ok
+   type(VResults), pointer :: res
+   real(c_double), pointer :: dip_out(:), quad_out(:), mol_quad_out(:)
+   ok = 0
+   if (.not.c_associated(venv) .or. .not.c_associated(vres)) return
+   if (natoms <= 0 .or. .not.c_associated(dip_ptr) .or. .not.c_associated(quad_ptr) .or. &
+       & .not.c_associated(mol_quad_ptr)) return
+   call c_f_pointer(vres, res)
+   if (.not.allocated(res%props)) return
+   if (.not.res%props%has_multipoles .or. res%props%natoms /= natoms) return
+   if (.not.allocated(res%props%atomic_dipoles) .or. .not.allocated(res%props%atomic_quadrupoles)) return
+   if (.not.all(ieee_is_finite(res%props%atomic_dipoles)) .or. &
+       & .not.all(ieee_is_finite(res%props%atomic_quadrupoles)) .or. &
+       & .not.all(ieee_is_finite(res%props%molecular_quadrupole))) return
+   call c_f_pointer(dip_ptr, dip_out, [3*natoms])
+   call c_f_pointer(quad_ptr, quad_out, [6*natoms])
+   call c_f_pointer(mol_quad_ptr, mol_quad_out, [6])
+   dip_out = reshape(res%props%atomic_dipoles, [3*natoms])
+   quad_out = reshape(res%props%atomic_quadrupoles, [6*natoms])
+   mol_quad_out = res%props%molecular_quadrupole
+   ok = 1
+end function
+
+function rdkit_get_nuclear_esp(venv, vres, natoms, output_ptr) result(ok) &
+      & bind(C, name="xtb_rdkit_getNuclearESP")
+   type(c_ptr), value :: venv, vres, output_ptr
+   integer(c_int), value :: natoms
+   integer(c_int) :: ok
+   type(VEnvironment), pointer :: env
+   type(VResults), pointer :: res
+   real(c_double), pointer :: output(:)
+   real(wp), allocatable :: values(:), coefficients(:, :)
+   integer :: i, j
+   ok = 0
+   if (.not.c_associated(venv)) return
+   call c_f_pointer(venv, env)
+   call checkGlobalEnv
+   if (.not.c_associated(vres)) then
+      call env%ptr%error("Results object is not allocated", "rdkit_nuclear_esp")
+      return
+   end if
+   call c_f_pointer(vres, res)
+   if (.not.allocated(res%props)) then
+      call env%ptr%error("Properties snapshot unavailable", "rdkit_nuclear_esp")
+      return
+   end if
+   if (.not.res%props%has_nuclear_esp) then
+      call env%ptr%error("Nuclear ESP unavailable for this calculation", "rdkit_nuclear_esp")
+      return
+   end if
+   if (natoms <= 0 .or. natoms /= res%props%natoms .or. .not.c_associated(output_ptr)) then
+      call env%ptr%error("Nuclear ESP atom count/buffer null mismatch", "rdkit_nuclear_esp")
+      return
+   end if
+   do i = 1, natoms
+      do j = i + 1, natoms
+         if (norm2(res%props%xyz(:, i) - res%props%xyz(:, j)) < 1.0e-10_wp) then
+            call env%ptr%error("Nuclear ESP is singular for coincident nuclei", "rdkit_nuclear_esp")
+            return
+         end if
+      end do
+   end do
+   allocate(values(natoms))
+   associate(p => res%props)
+      if (allocated(res%esp)) then
+         call esp_nuclear(natoms, p%basis%nao, p%basis%nbf, p%xyz, p%z, &
+            & p%occ, res%esp%coefficients, p%basis, values)
+      else
+         allocate(coefficients(p%basis%nbf, p%basis%nao))
+         if (p%basis%nbf == p%basis%nao) then
+            coefficients = p%c_sao
+         else
+            call sao2cao(p%basis%nao, p%c_sao, p%basis%nbf, coefficients, p%basis)
+         end if
+         call esp_nuclear(natoms, p%basis%nao, p%basis%nbf, p%xyz, p%z, &
+            & p%occ, coefficients, p%basis, values)
+      end if
+   end associate
+   if (.not.all(ieee_is_finite(values))) then
+      call env%ptr%error("Nuclear ESP evaluation produced nonfinite values", "rdkit_nuclear_esp")
+      return
+   end if
+   call c_f_pointer(output_ptr, output, [natoms])
+   output = values
+   ok = 1
+end function
+
 end module xtb_api_results
