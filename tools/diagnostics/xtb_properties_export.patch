    endif
    call calc_dipole(mol%n,mol%at,mol%xyz,mol%z,basis%nao,wfn%P,dpint,dip,dipol)
 
+   ! Molecular traceless quadrupole tensor in e*Bohr^2 (xx, xy, yy, xz, yz, zz),
+   ! matching molmom in aespot.F90.
+   block
+      real(wp) :: tma(6), tmb(6), tmc(6), qtr
+      integer :: ia_q, ja_q, ka_q, la_q
+      tma = 0.0_wp
+      tmb = 0.0_wp
+      tmc = 0.0_wp
+      do ia_q = 1, mol%n
+         do ja_q = 1, 3
+            do ka_q = 1, ja_q
+               la_q = ja_q*(ja_q-1)/2 + ka_q
+               tma(la_q) = tma(la_q) + mol%xyz(ja_q,ia_q)*mol%xyz(ka_q,ia_q)*wfn%q(ia_q)
+               tmb(la_q) = tmb(la_q) + wfn%dipm(ka_q,ia_q)*mol%xyz(ja_q,ia_q) &
+                  &                  + wfn%dipm(ja_q,ia_q)*mol%xyz(ka_q,ia_q)
+               tmc(la_q) = tmc(la_q) + wfn%qp(la_q,ia_q)
+            end do
+         end do
+      end do
+      qtr = 0.5_wp * (tma(1) + tma(3) + tma(6))
+      tma = 1.5_wp * tma
+      tma(1) = tma(1) - qtr; tma(3) = tma(3) - qtr; tma(6) = tma(6) - qtr
+      qtr = 0.5_wp * (tmb(1) + tmb(3) + tmb(6))
+      tmb = 1.5_wp * tmb
+      tmb(1) = tmb(1) - qtr; tmb(3) = tmb(3) - qtr; tmb(6) = tmb(6) - qtr
+      res%quadrupole = tma + tmb + tmc
+   end block
+
+   if (allocated(scD4)) then
+      allocate(aw(23, mol%n), c6ab(mol%n, mol%n), source=0.0_wp)
+      call mdisp(scD4%dispm, mol%n, scD4%ndim, mol%at, wfn%q, mol%xyz, &
+         & scD4%g_a, scD4%g_c, scD4%gweight, scD4%refC6, &
+         & molc6, molc8, molpol, aout=aw, cout=c6ab)
+      res%molpol = molpol
+      res%rdkit_molc6 = molc6
+      res%rdkit_molc8 = molc8
+      res%rdkit_alpha_atom = aw(1, :)
+      res%rdkit_c6_atom = [(c6ab(i, i), i=1, mol%n)]
+      res%rdkit_has_polarizability = .true.
+   end if
+
    if (profile) call timer%measure(7)
 
 
