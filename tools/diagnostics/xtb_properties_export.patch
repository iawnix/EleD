@@ -400,6 +400,70 @@
       enddo
       end
 
+! Exact electrostatic potential at nuclear positions (EPN, V_N) in Eh/e.
+! Omits the singular self-nuclear term i == k and uses tight screening.
+      subroutine esp_nuclear(n,nmo,nbf,xyz,z,occ,C,basis,values)
+      use xtb_type_basisset
+      use xtb_intpack, only: opaa0
+      implicit none
+      type(TBasisset), intent(in) :: basis
+      integer n,nmo,nbf
+      real*8 xyz(3,n),z(n),occ(nmo),C(nbf,nmo)
+      real*8 values(n)
+      real*8 p,cc,est,gama,efact,e(3),dd(35),a(3),b(3)
+      real*8 rab,r,weight,v
+      integer i,j,k,m,ii,jj,ip,jp,iii,jjj,nnn
+      values=0.0d0
+      do k=1,n
+         do i=1,n
+            if(i.ne.k) then
+               r=sqrt(sum((xyz(:,i)-xyz(:,k))**2))
+               values(k)=values(k)+z(i)/r
+            endif
+         enddo
+      enddo
+      ip=0
+      do i=1,nbf
+         a=xyz(:,basis%aoat(i))
+         jp=0
+         do j=1,i
+            p=0.0d0
+            do m=1,nmo
+               if(occ(m).gt.1.d-12) p=p+occ(m)*C(i,m)*C(j,m)
+            enddo
+            if(i.ne.j) p=2.0d0*p
+            if(abs(p).ge.1.d-12) then
+               b=xyz(:,basis%aoat(j))
+               rab=sum((a-b)**2)
+               do ii=1,basis%nprim(i)
+                  iii=ip+ii
+                  do jj=1,basis%nprim(j)
+                     jjj=jp+jj
+                     gama=1.0d0/(basis%alp(iii)+basis%alp(jjj))
+                     est=rab*basis%alp(iii)*basis%alp(jjj)*gama
+                     cc=basis%cont(iii)*basis%cont(jjj)
+                     if(est.lt.25.0d0.and.abs(cc*p).gt.1.d-14) then
+                        call propa_data(a,b,basis%alp(iii),
+     &                     basis%alp(jjj),basis%lao(i),basis%lao(j),
+     &                     nnn,efact,gama,e,dd)
+                        weight=cc*efact*p
+                        if(abs(weight).gt.1.d-14) then
+                           do k=1,n
+                              call propa1(opaa0,xyz(:,k),nnn,
+     &                                    gama,e,dd,v)
+                              values(k)=values(k)-v*weight
+                           enddo
+                        endif
+                     endif
+                  enddo
+               enddo
+            endif
+            jp=jp+basis%nprim(j)
+         enddo
+         ip=ip+basis%nprim(i)
+      enddo
+      end
+
 !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
 ! no f-functions !
 
