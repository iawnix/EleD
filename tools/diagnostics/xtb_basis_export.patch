+! Project-local extension ABI. Upstream xtb_getAPIVersion is unchanged.
+function rdkit_basis_version() result(version) bind(C, name="xtb_rdkit_getBasisAPIVersion")
+   integer(c_int) :: version
+   version = 1
+end function
+
+subroutine rdkit_keep_overlap(venv, vres, enabled) bind(C, name="xtb_rdkit_setKeepOverlap")
+   type(c_ptr), value :: venv, vres
+   logical(c_bool), value :: enabled
+   type(VEnvironment), pointer :: env
+   type(VResults), pointer :: res
+   if (.not.c_associated(venv)) return
+   call c_f_pointer(venv, env)
+   if (.not.c_associated(vres)) then
+      call env%ptr%error("Results are not allocated", "rdkit_setKeepOverlap")
+      return
+   end if
+   call c_f_pointer(vres, res)
+   res%rdkit_keep_basis = enabled
+   if (allocated(res%chk)) call res%chk%wfn%clear_basis
+end subroutine
+
+logical function rdkit_basis_ready(venv, vres, env, res) result(ready)
+   type(c_ptr), value :: venv, vres
+   type(VEnvironment), pointer :: env
+   type(VResults), pointer :: res
+   ready = .false.
+   if (.not.c_associated(venv)) return
+   call c_f_pointer(venv, env)
+   if (.not.c_associated(vres)) then
+      call env%ptr%error("Results are not allocated", "rdkit_basis")
+      return
+   end if
+   call c_f_pointer(vres, res)
+   if (allocated(res%chk)) then
+      ready = allocated(res%chk%wfn%rdkit_overlap)
+   end if
+   if (.not.ready) call env%ptr%error("No retained basis from a successful single point", "rdkit_basis")
+end function
+
+subroutine rdkit_basis_size(venv, vres, sizes_ptr) bind(C, name="xtb_rdkit_getBasisSize")
+   type(c_ptr), value :: venv, vres, sizes_ptr
+   type(VEnvironment), pointer :: env
+   type(VResults), pointer :: res
+   integer(c_int), pointer :: sizes(:)
+   if (.not.rdkit_basis_ready(venv, vres, env, res)) return
+   if (.not.c_associated(sizes_ptr)) then
+      call env%ptr%error("Null size buffer", "rdkit_basis")
+      return
+   end if
+   call c_f_pointer(sizes_ptr, sizes, [3])
+   sizes = [res%chk%wfn%n, res%chk%wfn%nshell, res%chk%wfn%nao]
+end subroutine
+
+subroutine rdkit_overlap(venv, vres, capacity, output_ptr) bind(C, name="xtb_rdkit_getOverlap")
+   type(c_ptr), value :: venv, vres, output_ptr
+   integer(c_int), value :: capacity
+   type(VEnvironment), pointer :: env
+   type(VResults), pointer :: res
+   real(c_double), pointer :: output(:)
+   integer :: count
+   if (.not.rdkit_basis_ready(venv, vres, env, res)) return
+   count = size(res%chk%wfn%rdkit_overlap)
+   if (capacity /= count .or. .not.c_associated(output_ptr)) then
+      call env%ptr%error("Overlap buffer size/null mismatch", "rdkit_basis")
+      return
+   end if
+   call c_f_pointer(output_ptr, output, [count])
+   output = reshape(res%chk%wfn%rdkit_overlap, [count])
+end subroutine
+
+subroutine rdkit_basis_map(venv, vres, nao, nshell, aa_ptr, as_ptr, sa_ptr, sl_ptr) &
+      & bind(C, name="xtb_rdkit_getBasisMap")
+   type(c_ptr), value :: venv, vres, aa_ptr, as_ptr, sa_ptr, sl_ptr
+   integer(c_int), value :: nao, nshell
+   type(VEnvironment), pointer :: env
+   type(VResults), pointer :: res
+   integer(c_int), pointer :: aa(:), ash(:), sa(:), sl(:)
+   if (.not.rdkit_basis_ready(venv, vres, env, res)) return
+   if (nao /= res%chk%wfn%nao .or. nshell /= res%chk%wfn%nshell .or. &
+       & .not.c_associated(aa_ptr) .or. .not.c_associated(as_ptr) .or. &
+       & .not.c_associated(sa_ptr) .or. .not.c_associated(sl_ptr)) then
+      call env%ptr%error("Basis map buffer size/null mismatch", "rdkit_basis")
+      return
+   end if
+   call c_f_pointer(aa_ptr, aa, [nao])
+   call c_f_pointer(as_ptr, ash, [nao])
+   call c_f_pointer(sa_ptr, sa, [nshell])
+   call c_f_pointer(sl_ptr, sl, [nshell])
+   aa = res%chk%wfn%rdkit_ao_atom
+   ash = res%chk%wfn%rdkit_ao_shell
+   sa = res%chk%wfn%rdkit_shell_atom
+   sl = res%chk%wfn%rdkit_shell_l
+end subroutine
+
 end module xtb_api_results
