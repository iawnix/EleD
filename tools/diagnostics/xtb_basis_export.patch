--- a/include/xtb.h
+++ b/include/xtb.h
@@ -339,6 +339,20 @@ xtb_getOrbitalCoefficients(xtb_TEnvironment /* env */,
                            xtb_TResults /* res */,
                            double* /* c */) XTB_API_SUFFIX__VERSION_2_0_0;
 
+/* rdkit-eth extension ABI v1; upstream API version remains unchanged.
+ * Enable on Results BEFORE singlepoint. Copies own their snapshots.
+ * Failed/repeated calculations and toggling retention invalidate old snapshots.
+ * Sizes: [natoms, nshell, nao]. All map indices are ZERO-based, in native AO order.
+ * Overlap is column-major [nao, nao], matching orbital coefficients.
+ * Buffers must have exactly the specified capacity; errors leave buffers untouched.
+ */
+extern XTB_API_ENTRY int XTB_API_CALL xtb_rdkit_getBasisAPIVersion(void);
+extern XTB_API_ENTRY void XTB_API_CALL xtb_rdkit_setKeepOverlap(xtb_TEnvironment, xtb_TResults, bool);
+extern XTB_API_ENTRY void XTB_API_CALL xtb_rdkit_getBasisSize(xtb_TEnvironment, xtb_TResults, int*);
+extern XTB_API_ENTRY void XTB_API_CALL xtb_rdkit_getOverlap(xtb_TEnvironment, xtb_TResults, int, double*);
+extern XTB_API_ENTRY void XTB_API_CALL xtb_rdkit_getBasisMap(xtb_TEnvironment, xtb_TResults,
+    int, int, int*, int*, int*, int*);
+
 #ifdef __cplusplus
 }
 #endif
